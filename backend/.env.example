# =============================================================================
# CareTrack Clinic — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- PostgreSQL (Render Managed Postgres connection string) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- JWT ---
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')|pbcopy"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
